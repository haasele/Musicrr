# --- Database & cache
POSTGRES_DB=musicrr
POSTGRES_USER=musicrr
# Production: set a long random secret (e.g. openssl rand -hex 32)
POSTGRES_PASSWORD=musicrr
POSTGRES_PORT=5432
DRAGONFLY_PORT=6379

# Public URL of the API (used in links, share metadata; not the browser CORS list)
PUBLIC_BASE_URL=https://api-musicrr.haasele.dev

# --- CORS: every browser origin that hosts the *web* UI (scheme + host + port, no path, comma-separated)
# If the UI is at http://45.83.105.35:3000, you MUST include that exact string (not the API :3001 URL).
# CORS_ORIGINS=http://45.83.105.35:3000
# Debugging only: allow all origins (insecure) — CORS_ALLOW_ALL=1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://45.83.105.35:3000,https://musicrr.haasele.dev,https://api-musicrr.haasele.dev,http://45.83.105.35:3001

# "production" in deployment so CORS is not accidentally wide-open when CORS_ORIGINS is empty
# NODE_ENV=development

# --- Initial admin (only created on first run if the user does not exist)
# Production: set strong, unique values before first deploy
ADMIN_EMAIL=admin@haasele.dev
ADMIN_PASSWORD=Sommerlicher Kaffeeabend!
ADMIN_NAME=Musicrr Admin

# --- Web (Vite): optional override; if empty, the browser uses same host + :3001
# VITE_API_ORIGIN=https://api.example.com
