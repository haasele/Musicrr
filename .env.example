# --- Database & cache
POSTGRES_DB=musicrr
POSTGRES_USER=musicrr
# Production: set a long random secret (e.g. openssl rand -hex 32)
POSTGRES_PASSWORD=musicrr
POSTGRES_PORT=5432
DRAGONFLY_PORT=6379

# Public URL of the API (used in links, share metadata; not the browser CORS list)
PUBLIC_BASE_URL=https://api.example.com

# --- CORS: browser origins allowed to call the API (comma-separated, no wildcards)
# Local dev: keep both hostnames. Production: your real web app origin, e.g. https://app.example.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# "production" in deployment so CORS is not accidentally wide-open when CORS_ORIGINS is empty
# NODE_ENV=development

# --- Initial admin (only created on first run if the user does not exist)
# Production: set strong, unique values before first deploy
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now-please
ADMIN_NAME=Musicrr Admin

# --- Web (Vite): optional override; if empty, the browser uses same host + :3001
# VITE_API_ORIGIN=https://api.example.com
